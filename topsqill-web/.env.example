# Where the Topsqill.ai API runs. The browser never talks to the database.
API_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080

# Used for absolute links in shared pages and sitemaps
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Maps browser key (restricted by referrer) for the listing map
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Same value as INTERNAL_PROXY_SECRET in topsqill-backend/.env
INTERNAL_PROXY_SECRET=
# Proxies in front of this server that append to X-Forwarded-For (1 on Cloud Run)
TRUSTED_PROXY_HOPS=1

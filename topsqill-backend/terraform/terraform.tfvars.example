project_id  = "topsqill-prod"      # the Project ID from the GCP console, not the display name
alert_email = "tech@topsqill.ai"

# No domain yet? Set this to false. Cloud Run serves the API on its own
# https://...run.app URL, and no load balancer or certificate is created.
# Switch it to true later, add the DNS records, and run terraform apply again.
use_custom_domain = false
api_domain        = "api.topsqill.ai"
cdn_domain        = "cdn.topsqill.ai"

# Small and cheap to start with. Raise these when real traffic arrives.
environment       = "staging"
db_tier           = "db-custom-1-3840"   # 1 vCPU, 3.75 GB
redis_gb          = 1
api_min_instances = 0                    # scales to zero when nobody is using it
api_max_instances = 8
worker_max_instances = 2
# Email sign-in codes (any SMTP provider: Amazon SES, Resend, SendGrid, Brevo, Google Workspace).
# Add the password first:  printf '%s' 'PASSWORD' | gcloud secrets versions add topsqill-staging-smtp-password --data-file=-
smtp_host  = ""                          # e.g. "smtp.resend.com"
smtp_port  = 587
smtp_user  = ""                          # e.g. "resend"
email_from = ""                          # e.g. "Topsqill.ai <no-reply@topsqill.ai>"

# Imports from 99acres, Housing.com... through Bright Data. Store the key in
# Secret Manager first (topsqill-<env>-brightdata-key), then turn this on.
brightdata_enabled = false
brightdata_zone    = "topsqill_unlocker"

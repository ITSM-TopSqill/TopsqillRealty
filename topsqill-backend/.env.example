NODE_ENV=development
PORT=8080

# Postgres (through PgBouncer in production)
DATABASE_URL=postgres://topsqill:topsqill@localhost:5432/topsqill
DATABASE_URL_REPLICA=
DB_POOL_MAX=10

# Redis (Memorystore in production)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Shared with the web app (same value in topsqill-web/.env) so it can pass the
# visitor's IP for rate limits. Without it, forwarded IP headers are ignored.
INTERNAL_PROXY_SECRET=
# Proxies in front of the API: 0 locally, 1 behind Cloud Run, 2 behind the load balancer too.
TRUST_PROXY_HOPS=0

# Google Cloud
GCP_PROJECT_ID=topsqill-prod
GCS_BUCKET_UPLOADS=topsqill-uploads
GCS_BUCKET_PUBLIC=topsqill-media
CDN_BASE_URL=https://cdn.topsqill.ai

# SMS/WhatsApp OTP sender (leave blank in dev: the OTP is logged instead)
OTP_PROVIDER=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta app secret: webhooks (lead ads, WhatsApp) are refused in production without it
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# AI (server only)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

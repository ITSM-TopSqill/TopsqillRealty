{
  "name": "topsqill-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Topsqill.ai backend: NestJS (Fastify) + PostgreSQL + Redis on Google Cloud",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "start:worker": "node dist/worker/main.js",
    "dev": "tsx watch src/main.ts",
    "dev:worker": "tsx watch worker/main.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "loadtest": "node scripts/load-test.js",
    "db:migrate:prod": "node dist/src/db/migrate.js",
    "db:seed:prod": "node dist/scripts/seed.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/compress": "8.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/static": "^10.1.2",
    "@google-cloud/secret-manager": "7.2.0",
    "@google-cloud/storage": "7.22.0",
    "@google-cloud/video-transcoder": "5.2.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-fastify": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "11.0.0",
    "@nestjs/throttler": "6.4.0",
    "bullmq": "5.81.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "drizzle-orm": "0.45.4",
    "ioredis": "5.11.1",
    "nestjs-pino": "5.3.1",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "uuid": "11.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/pg": "8.23.1",
    "autocannon": "8.0.0",
    "drizzle-kit": "0.31.6",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
